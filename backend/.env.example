# PostgreSQL 접속 문자열 (asyncpg 드라이버)
# 예: postgresql+asyncpg://postgres:password@localhost:5432/lisn
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/lisn

# JWT 서명 키.
# ⚠ CHANGE_ME 인 채로는 서버가 토큰을 발급하지 않습니다(security._secret).
#   이 저장소는 공개라 예제 값이 곧 공개된 서명 키입니다. 그대로 두면 누구나
#   role=ADMIN 토큰을 직접 서명해 /admin/* 으로 전 사용자 리포트를 볼 수 있습니다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_HOURS=24

# 비밀번호 재설정 토큰을 로그로 출력할지. SMTP 가 범위 밖이라 개발 중 흐름을
# 확인하려면 켭니다.
# ⚠ 운영에서는 절대 켜지 마세요 — 로그를 볼 수 있는 사람이 누구 계정이든
#   비밀번호를 바꿀 수 있게 됩니다.
PASSWORD_RESET_LOG_TOKEN=false

# 컬럼 암호화 키 (AES-256-GCM, base64 인코딩된 32바이트)
# 02-F (3) 대상은 현재 USERS.phone 하나입니다.
# 생성: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# ⚠ 이 키를 잃으면 저장된 연락처를 복호화할 수 없습니다.
ENCRYPTION_KEY=CHANGE_ME

# ---------------------------------------------------------------
# LLM 공급자
# ---------------------------------------------------------------
# gemini = 개발 기본값(무료 한도) · openai = 정확도 검사·시연
#
# ⚠ Gemini 는 임시 수단입니다. 산출 문서(01·02)의 "외부 OpenAI API" 가 정본이라
#   시연과 정확도 검사는 openai 로 돌립니다.
LLM_PROVIDER=gemini

# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

OPENAI_API_KEY=

# 작업별 모델. Gemini 는 무료 한도가 모델별로 잡히므로 일부러 갈라놨습니다.
# 전부 한 모델로 몰면 그 하나가 병목이 됩니다 — 특히 reply·crisis 는
# analyze_and_reply 에서 **동시에** 호출됩니다.
#
# ⚠ 쓰면 안 되는 모델 (2026.08.01 실측 — docs/llm/USAGE_LOG.md LLM-004)
#     gemini-3.5-flash   503 UNAVAILABLE
#     gemini-2.5-pro     429, 무료 한도 없음
#
# 아래는 config.py 의 기본값과 같습니다. 바꿀 때만 주석을 푸세요.
# GEMINI_MODEL_CRISIS=gemini-3.6-flash        위기 판정 — 안전 직결, 가장 좋은 모델
# GEMINI_MODEL_REPLY=gemini-2.5-flash         페르소나 응답 — 품질·지연 균형
# GEMINI_MODEL_SUMMARY=gemini-3.5-flash-lite  세션 요약 — 백그라운드
# GEMINI_MODEL_DAILY=gemini-3.1-flash-lite    홈 한줄 요약 — 캐시됨
# OPENAI_MODEL=gpt-5.6

# NFR-DV-001 이 챗봇 응답 3초를 요구합니다.
# ⚠ LLM_MAX_RETRIES 를 올리지 마세요. 무료 티어는 모델이 통째로 503 이 되는 일이
#   있고, 기본 재시도(2회)면 죽은 모델 하나가 3초 예산을 통째로 먹습니다(실측 13.95초).
# LLM_TIMEOUT_SECONDS=8.0
# LLM_MAX_RETRIES=0

# AI 추론 서버 (내부 통신, 인증 없음 - 외부에 포트를 열지 말 것)
AI_SERVER_URL=http://localhost:8001

# 관리자 웹 개발 서버. 여러 주소는 쉼표로 구분
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
