# PostgreSQL 접속 문자열 (asyncpg 드라이버)
# 예: postgresql+asyncpg://postgres:password@localhost:5432/lisn
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/lisn

# JWT 서명 키. 운영에서는 반드시 교체할 것
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_HOURS=24

# OpenAI
OPENAI_API_KEY=

# AI 추론 서버 (내부 통신, 인증 없음 - 외부에 포트를 열지 말 것)
AI_SERVER_URL=http://localhost:8001

# 관리자 웹 개발 서버. 여러 주소는 쉼표로 구분
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
