# PostgreSQL 접속 문자열 (asyncpg 드라이버)
# 예: postgresql+asyncpg://postgres:password@localhost:5432/lisn
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/lisn

# JWT 서명 키. 운영에서는 반드시 교체할 것
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_HOURS=24

# 컬럼 암호화 키 (AES-256-GCM, base64 인코딩된 32바이트)
# 02-F (3) 대상은 현재 USERS.phone 하나입니다.
# 생성: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# ⚠ 이 키를 잃으면 저장된 연락처를 복호화할 수 없습니다.
ENCRYPTION_KEY=CHANGE_ME

# ---------------------------------------------------------------
# LLM 공급자
# ---------------------------------------------------------------
# gemini = 개발 기본값(무료 한도) · openai = 정확도 검사·시연
#
# ⚠ Gemini 는 임시 수단입니다. 산출 문서(01·02)의 "외부 OpenAI API" 가 정본이라
#   시연과 정확도 검사는 openai 로 돌립니다.
LLM_PROVIDER=gemini

# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

OPENAI_API_KEY=

# 작업별 모델. Gemini 는 무료 한도가 모델별로 잡히므로 일부러 갈라놨습니다.
# 전부 한 모델로 몰면 그 하나가 병목이 됩니다 — 특히 reply·crisis 는 동시에 호출됩니다.
# GEMINI_MODEL_REPLY=gemini-3.6-flash
# GEMINI_MODEL_CRISIS=gemini-3.5-flash
# GEMINI_MODEL_SUMMARY=gemini-3.5-flash-lite
# GEMINI_MODEL_DAILY=gemini-3.1-flash-lite
# OPENAI_MODEL=gpt-5.6

# AI 추론 서버 (내부 통신, 인증 없음 - 외부에 포트를 열지 말 것)
AI_SERVER_URL=http://localhost:8001

# 관리자 웹 개발 서버. 여러 주소는 쉼표로 구분
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
