# 2단계 — Let's Encrypt 인증서를 받은 뒤 이 파일을 nginx/lisn.conf 로
# 복사해 덮어쓰세요(파일명을 바꾸는 게 아니라 내용을 이걸로 교체합니다):
#
#   cp infra/nginx/lisn-ssl.conf.sample infra/nginx/lisn.conf
#   (아래 __DOMAIN__ 을 실제 도메인으로 바꾼 뒤)
#   sed -i 's/__DOMAIN__/실제도메인/g' infra/nginx/lisn.conf
#   docker compose restart nginx
#
# __DOMAIN__ 자리는 두 종류입니다 — nip.io 방식이면 "203-0-113-1.nip.io"
# 처럼, 실 도메인을 샀으면 그 도메인으로 바꾸세요.

server {
    listen 80;
    server_name __DOMAIN__;

    # 인증서 갱신은 계속 80 번으로 옵니다 — 이 location 을 지우면 안 됩니다.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 그 외 전부 HTTPS 로 넘깁니다.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10m;

    location /api/v1/ {
        proxy_pass http://backend:8000/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /docs {
        proxy_pass http://backend:8000/docs;
        proxy_set_header Host $host;
    }
    location /openapi.json {
        proxy_pass http://backend:8000/openapi.json;
        proxy_set_header Host $host;
    }

    location /health {
        proxy_pass http://backend:8000/health;
    }

    root /usr/share/nginx/html;
    index index.html;
    location / {
        try_files $uri $uri/ /index.html;
    }
}
