# infra/docker-compose.yml 이 읽는 변수. 복사해서 infra/.env 로 채우세요.
#   cp infra/.env.example infra/.env
#
# ⚠ 이 파일(.env)은 .gitignore 의 `.env.*` 규칙에 걸려 커밋되지 않습니다.
#   backend/.env 와 별개의 파일입니다 — 여기는 "컨테이너를 어떻게 띄울지"만
#   담고, 애플리케이션 설정(JWT_SECRET 등)은 여전히 backend/.env 가 정본입니다.

# postgres 컨테이너의 비밀번호. backend·ai-server 의 DATABASE_URL 도
# docker-compose.yml 에서 이 값으로 조립됩니다 — 한 곳만 바꾸면 됩니다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=CHANGE_ME
